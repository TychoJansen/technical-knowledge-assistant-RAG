{"qid": "77410975", "kind": "freshstack", "language": "python", "title": "How to use Langchain text splitter to reduce tokens in my text", "answer": "You can use the `TokenTextSplitter` to reduce tokens in your text. Here is an example of how to use it:\n\n", "valid_output": true, "insufficient_information": false, "retrieved": ["langchain/docs/docs/tutorials/pdf_qa.ipynb_0_6943", "langchain/libs/langchain/langchain/chains/mapreduce.py_0_4092", "langchain/docs/docs/how_to/split_by_token.ipynb_0_7093", "langchain/docs/docs/tutorials/rag.ipynb_14698_22145"], "cited_doc_ids": ["langchain/docs/docs/how_to/split_by_token.ipynb_0_7093"], "invalid_citations": [], "repaired_citations": [], "degenerate_answer": false, "context_coverage": 0.75, "context_recall": 0.06451612903225806, "nuggets": ["The text splitter breaks down text into chunks based on tokens and new lines, with chunk size specified by the user.", "The purpose of the text splitter is to divide documents into smaller chunks to retrieve the most relevant text pieces.", "The text splitter does not increase the amount of text that can be input into the prompt but helps fit relevant information within the token limit.", "Printing data before and after splitting can help visualize the effect of the text splitter."], "nuggets_present": null, "nugget_judge_ok": null, "citations": [{"doc_id": "langchain/docs/docs/how_to/split_by_token.ipynb_0_7093", "supported": null, "judge_supported": null, "quote": null, "quote_found": null, "judge_ok": null, "relevant_in_qrels": true, "judged_in_qrels": true}], "generation_s": 34.89529090002179, "judge_s": null, "prompt_tokens": 2645, "output_tokens": 77, "config": {"tokenizer": "word_stem", "query_mode": "full", "top_k": 4, "max_chars": 2000, "max_tokens": 800, "prompt": "f2d2db446790", "answer_rules": 4, "assistant_llm": {"model": "llama3.2:3b", "digest": "a80c4f17acd55265feec403c7aef86be0c25983ab279d83f3bcd3abbcb5b8b72", "num_ctx": 8192, "temperature": 0.0, "seed": 42}, "judge_ll